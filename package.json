{
  "name": "persian-tokenizer-lab",
  "version": "0.1.0",
  "private": true,
  "description": "TokenNama — an interactive Persian tokenization laboratory built with Vite, Python and Hazm.",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "start": "node scripts/dev.mjs --open",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1"
  },
  "engines": { "node": ">=22.12" }
}
